          "plan-vegetable-garden",
          "diagnose-plant-problem",
          "start-composting"
        ],
        "personas": [
          "master-gardener"
        ]
      },
      "hash": "sha256:38d457debc1fbc8b3346e484e561ec3545f9bab10c07f1572d323620e6974f8d"
