          "plan-marketing-campaign",
          "create-lead-magnet",
          "write-email-sequence"
        ],
        "personas": [
          "growth-marketer"
        ]
      },
      "hash": "sha256:44683a453117051051b7630d21f8352a38799a8101d1aaefaf7f1bd87ecb3035"
