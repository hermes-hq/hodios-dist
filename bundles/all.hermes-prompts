          "tailor-resume-to-job",
          "write-cover-letter",
          "prepare-star-stories"
        ],
        "personas": [
          "interview-coach"
        ]
      },
      "hash": "sha256:629256624af5e3c728e5b0a113dee185fae447a8f7f89e069eab2e1c6ae57731"
