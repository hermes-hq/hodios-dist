      ],
      "stage": [
        "build"
      ],
      "args": [
        {
          "name": "ingredients",
          "description": "What you have, roughly with amounts and how fresh (for example \"4 eggs, half a cabbage, 300 g cooked rice from yesterday, feta, lemons, the usual spices\").",
          "type": "text",
