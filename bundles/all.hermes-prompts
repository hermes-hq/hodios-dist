        "safety",
        "permits"
      ],
      "stage": [
        "plan"
      ],
      "args": [
        {
          "name": "project",
          "description": "What you want to do, where, and the key measurements (for example \"tile a 2 x 1.5 m bathroom splashback over old paint\", \"replace a ceiling light\", \"build a raised bed 2.4 x 1.2 m\").",
          "type": "text",
