          "fact-check-claims",
          "verify-citations",
          "compare-news-framing",
          "check-science-news-against-paper",
          "trace-quote-origin"
        ],
        "personas": [
          "research-librarian"
        ],
        "rules": [
          "source-citation-rules"
        ]
      },
