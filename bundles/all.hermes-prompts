      ],
      "stage": [
        "plan"
      ],
      "args": [
        {
          "name": "goal",
          "description": "What you are saving for and why it matters, plus anything relevant - your monthly surplus today, other goals competing for the money, any debts.",
          "type": "text",
          "required": true
        },
        {
          "name": "amount",
          "description": "Target amount to reach.",
