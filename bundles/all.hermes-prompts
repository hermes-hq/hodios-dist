          "model-unit-economics",
          "validate-business-idea",
          "run-swot-analysis"
        ],
        "personas": [
          "management-consultant",
          "startup-mentor"
        ]
      },
      "hash": "sha256:c86e3c7204a2e03f5b41ff9991792ad2ddc951f79e6177d3013ce6641f45d947"
